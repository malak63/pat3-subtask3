from machine import Pin, ADC, PWM
from time import sleep

# -----------------------------
# PIN DEFINITIONS
# -----------------------------

# Joystick
joystick_y = ADC(26)       # GP26 / ADC0
joystick_button = Pin(14, Pin.IN, Pin.PULL_UP)

# L298N motor driver
motor_en = PWM(Pin(15))
motor_in1 = Pin(2, Pin.OUT)
motor_in2 = Pin(3, Pin.OUT)

# Servo motor
servo = PWM(Pin(16))
servo.freq(50)

# Status LED
led = Pin(17, Pin.OUT)


# -----------------------------
# INITIAL SETTINGS
# -----------------------------

motor_en.freq(1000)

# Motor OFF
motor_in1.value(0)
motor_in2.value(0)
motor_en.duty_u16(0)

# Gripper starts CLOSED
gripper_closed = True


# -----------------------------
# SERVO FUNCTION
# -----------------------------

def servo_angle(angle):

    # Convert angle to servo duty cycle
    min_duty = 1500
    max_duty = 8000

    duty = int(
        min_duty + (angle / 180) * (max_duty - min_duty)
    )

    servo.duty_u16(duty)


# Start with gripper closed
servo_angle(20)


# -----------------------------
# START-UP LED FLASH
# -----------------------------

for i in range(3):
    led.value(1)
    sleep(0.5)

    led.value(0)
    sleep(0.5)

# LED remains ON during operation
led.value(1)


# -----------------------------
# GRIPPER CONTROL
# -----------------------------

last_button = 1

def check_gripper():

    global gripper_closed
    global last_button

    button = joystick_button.value()

    # Detect button press
    if button == 0 and last_button == 1:

        if gripper_closed:
            # Open gripper
            servo_angle(100)
            gripper_closed = False

        else:
            # Close gripper
            servo_angle(20)
            gripper_closed = True

        sleep(0.3)

    last_button = button


# -----------------------------
# MOTOR CONTROL
# -----------------------------

def control_motor():

    value = joystick_y.read_u16()

    # Joystick centre
    centre = 32768

    # Dead zone
    dead_zone = 5000

    difference = value - centre

    # Joystick pushed forward
    if difference > dead_zone:

        speed = int(
            (difference - dead_zone) /
            (32767 - dead_zone) * 65535
        )

        if speed > 65535:
            speed = 65535

        motor_in1.value(1)
        motor_in2.value(0)
        motor_en.duty_u16(speed)

    # Joystick pushed backwards
    elif difference < -dead_zone:

        speed = int(
            (-difference - dead_zone) /
            (32768 - dead_zone) * 65535
        )

        if speed > 65535:
            speed = 65535

        motor_in1.value(0)
        motor_in2.value(1)
        motor_en.duty_u16(speed)

    # Joystick centred
    else:

        motor_in1.value(0)
        motor_in2.value(0)
        motor_en.duty_u16(0)


# -----------------------------
# MAIN PROGRAM
# -----------------------------

while True:

    control_motor()
    check_gripper()

    sleep(0.02)
